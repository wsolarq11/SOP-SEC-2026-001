# SOP 知识库版本管理
# .workbuddy 为工具元数据，不纳入 SOP 版本库
.workbuddy/
.jspace/

# 本环境监视器会损坏 .docx，绝不纳入版本控制
*.docx

# Python 缓存
__pycache__/
*.pyc

# 排版中间产物（由 md 经 sop_to_docx 生成，可复现，不纳入版本）
output/**/stage2/
output/**/restructured.html

# 工具元数据（飞书 skill 镜像/锁定文件、上传 token），不纳入 SOP 版本库
skills-lock.json
.agents/
.claude/
.zcode/
.publish-tokens
